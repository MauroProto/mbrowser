{
  "name": "@local/mbrowser",
  "version": "3.1.1",
  "private": true,
  "description": "Conecta DeepSeek Harness con Chrome y supervisa sus pestañas en segundo plano.",
  "repository": { "type": "git", "url": "git+https://github.com/MauroProto/mbrowser.git" },
  "homepage": "https://github.com/MauroProto/mbrowser",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.js extension/tests/*.test.mjs",
    "test:extension": "node --test extension/tests/*.test.mjs",
    "test:live": "node --test tests/live/*.test.js",
    "measure:tools": "node scripts/measure-tools.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "gpt-tokenizer": "4.1.0"
  },
  "type": "module",
  "main": "host-v2.js",
  "exports": {
    ".": "./host-v2.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host-v2.js",
    "lib/bridge.js",
    "lib/engine.js",
    "lib/extension-transport.js",
    "lib/link-chrome.js",
    "lib/page-functions.js",
    "lib/tools.js",
    "extension/*.js",
    "extension/*.html",
    "extension/*.css",
    "extension/manifest.json",
    "extension/icons/",
    "extension/README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
