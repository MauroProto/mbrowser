{
  "manifest_version": 3,
  "name": "mbrowser · Chrome bajo tu control",
  "short_name": "mbrowser",
  "description": "Conecta tu Chrome con DeepSeek Harness, con autorización persistente, alcance visible y pausa inmediata.",
  "version": "3.1.1",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["debugger", "tabs", "storage", "alarms", "sidePanel"],
  "side_panel": {
    "default_path": "panel.html"
  },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [{
    "matches": ["http://127.0.0.1/mbrowser/connect"],
    "js": ["connect.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir mbrowser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:*; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "incognito": "not_allowed"
}
